<Window x:Class="FocusCatAI.Presentation.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WorkBuddy" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="#FFF7F7F9"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B6B76" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,1" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="WorkBuddy" FontSize="26" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Foreground="#FF6B6B76" Margin="0,2,0,6" />

        <TextBlock Style="{StaticResource Caption}" Text="Copyright" />
        <TextBlock x:Name="CopyrightText" Style="{StaticResource Value}" />

        <TextBlock Style="{StaticResource Caption}" Text="License" />
        <TextBlock x:Name="LicenseText" Style="{StaticResource Value}" />

        <TextBlock Style="{StaticResource Caption}" Text="GitHub" />
        <TextBlock x:Name="RepositoryText" Style="{StaticResource Value}" />

        <TextBlock Style="{StaticResource Caption}" Text="Data folder" />
        <TextBlock x:Name="DataFolderText" Style="{StaticResource Value}" />

        <TextBlock Style="{StaticResource Caption}" Text="Open-source notice" />
        <TextBlock x:Name="NoticeText" Style="{StaticResource Value}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="OpenGitHubButton" Content="Open GitHub" Padding="14,6" Margin="0,0,10,0" Click="OnOpenGitHub" />
            <Button x:Name="CloseButton" Content="Close" Padding="14,6" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
